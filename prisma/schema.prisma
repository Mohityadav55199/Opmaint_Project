datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  REQUESTER
  AREA_OWNER
  SAFETY_OFFICER
  ADMIN
}

enum PermitStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ACTIVE
  SUSPENDED
  REJECTED
  EXPIRED
  CLOSED
  CLOSED_VERIFIED
  CANCELLED
}

enum ApprovalSlot {
  AREA_OWNER
  SAFETY_OFFICER
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

enum ExtensionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EntryExitDirection {
  ENTRY
  EXIT
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  ownedAreas          Area[]            @relation("AreaOwner")
  requestedPermits    Permit[]          @relation("PermitRequester")
  activatedPermits    Permit[]          @relation("PermitActivator")
  suspendedPermits    Permit[]          @relation("PermitSuspender")
  closedPermits       Permit[]          @relation("PermitCloser")
  approvals           Approval[]
  workLogs            WorkLogEntry[]
  recordedEntryExits  EntryExitLog[]    @relation("RecordedEntryExitLogs")
  requestedExtensions PermitExtension[] @relation("ExtensionRequester")
  reviewedExtensions  PermitExtension[] @relation("ExtensionReviewer")
  auditLogs           AuditLog[]

  @@index([email])
  @@index([role])
  @@index([isActive])
}

model Plant {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  timezone  String   @default("Asia/Kolkata")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  areas Area[]
}

model Area {
  id        String   @id @default(cuid())
  plantId   String
  code      String
  name      String
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plant     Plant       @relation(fields: [plantId], references: [id], onDelete: Cascade)
  owner     User        @relation("AreaOwner", fields: [ownerId], references: [id])
  equipment Equipment[]

  @@unique([plantId, code])
  @@index([ownerId])
}

model Equipment {
  id          String   @id @default(cuid())
  areaId      String
  tagNumber   String   @unique
  name        String
  criticality String   @default("MEDIUM")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  area    Area     @relation(fields: [areaId], references: [id], onDelete: Cascade)
  permits Permit[]

  @@index([areaId])
}

model Permit {
  id                   String       @id @default(cuid())
  permitSequence       Int          @default(autoincrement())
  permitNumber         String       @unique
  status               PermitStatus @default(DRAFT)
  type                 String // HOT_WORK, CONFINED_SPACE_ENTRY, WORKING_AT_HEIGHT, ELECTRICAL_ISOLATION_LOTO, EXCAVATION, etc.
  requesterId          String
  contractorTeam       String
  workDescription      String
  equipmentId          String // Sole authoritative location anchor -> Equipment -> Area -> Plant
  plannedStartTime     DateTime
  plannedEndTime       DateTime // Originally planned/requested end time
  expiresAt            DateTime // Authoritative validity boundary
  actualStartTime      DateTime?
  actualEndTime        DateTime?
  hazards              Json         @default("[]")
  ppeRequired          Json         @default("[]")
  precautionsChecklist Json         @default("{}")
  typeData             Json         @default("{}") // Extensible JSONB payload validated by PermitTypeRegistry
  approvalRound        Int          @default(1)
  version              Int          @default(1) // Optimistic concurrency control
  rejectionReason      String?
  suspensionReason     String?
  cancellationReason   String?
  workCompletionNotes  String?
  closureVerifiedNotes String?
  activatedById        String?
  suspendedById        String?
  closedById           String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  // Relations
  equipment     Equipment         @relation(fields: [equipmentId], references: [id])
  requester     User              @relation("PermitRequester", fields: [requesterId], references: [id])
  activatedBy   User?             @relation("PermitActivator", fields: [activatedById], references: [id])
  suspendedBy   User?             @relation("PermitSuspender", fields: [suspendedById], references: [id])
  closedBy      User?             @relation("PermitCloser", fields: [closedById], references: [id])
  approvals     Approval[]
  workLogs      WorkLogEntry[]
  entryExitLogs EntryExitLog[]
  extensions    PermitExtension[]
  auditLogs     AuditLog[]

  @@index([status])
  @@index([type])
  @@index([equipmentId])
  @@index([requesterId])
  @@index([expiresAt])
  @@index([plannedStartTime, plannedEndTime])
}

model Approval {
  id           String           @id @default(cuid())
  permitId     String
  round        Int
  slot         ApprovalSlot
  approverId   String
  decision     ApprovalDecision
  comment      String?
  signatureSvg String?
  createdAt    DateTime         @default(now())

  permit   Permit @relation(fields: [permitId], references: [id], onDelete: Cascade)
  approver User   @relation(fields: [approverId], references: [id])

  @@unique([permitId, round, slot])
  @@unique([permitId, round, approverId]) // Guard: same approver cannot fill both slots in the same round
  @@index([permitId, round])
  @@index([approverId])
}

model WorkLogEntry {
  id          String   @id @default(cuid())
  permitId    String
  authorId    String
  description String
  performedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  permit Permit @relation(fields: [permitId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@index([permitId])
}

model EntryExitLog {
  id           String             @id @default(cuid())
  permitId     String
  direction    EntryExitDirection @default(ENTRY)
  personName   String
  at           DateTime           @default(now())
  recordedById String
  createdAt    DateTime           @default(now())

  permit     Permit @relation(fields: [permitId], references: [id], onDelete: Cascade)
  recordedBy User   @relation("RecordedEntryExitLogs", fields: [recordedById], references: [id])

  @@index([permitId, at])
}

model PermitExtension {
  id                String          @id @default(cuid())
  permitId          String
  requestedHours    Int
  reason            String
  status            ExtensionStatus @default(PENDING)
  requesterId       String
  approverId        String?
  previousExpiresAt DateTime
  newExpiresAt      DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  permit    Permit @relation(fields: [permitId], references: [id], onDelete: Cascade)
  requester User   @relation("ExtensionRequester", fields: [requesterId], references: [id])
  approver  User?  @relation("ExtensionReviewer", fields: [approverId], references: [id])

  @@index([permitId])
}

model AuditLog {
  id         String   @id @default(cuid())
  permitId   String
  actorId    String?
  actorLabel String // User display name or "SYSTEM"
  actorRole  String
  action     String // SUBMIT, APPROVE, REJECT, ACTIVATE, SUSPEND, RESUME, CLOSE, VERIFY, CANCEL, EDIT_FIELD, EXTEND, EXPIRE
  field      String?
  fromValue  String?
  toValue    String?
  comment    String?
  metadata   Json?
  createdAt  DateTime @default(now())

  permit Permit @relation(fields: [permitId], references: [id], onDelete: Restrict)
  actor  User?  @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([permitId, createdAt])
}
